# ==============================================================================
# CPJudge Production Environment Variables (Internet Deployment)
# ==============================================================================
# Copy this file to .env.production and customize the values:
#   cp .env.production.example .env.production
# ==============================================================================

# 1. Domain Configuration (for Caddy automated Let's Encrypt HTTPS)
# Example: DOMAIN=judge.pucit.edu.pk or DOMAIN=judge.mydomain.com
DOMAIN=localhost

# 2. Flask Application Secret Key (MANDATORY IN PRODUCTION)
# Generate a secure 64-character random key using:
#   python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=change_this_to_a_secure_random_64_character_hex_string

# 3. PostgreSQL Database Credentials
POSTGRES_USER=cpjudge
POSTGRES_PASSWORD=replace_with_a_strong_database_password
POSTGRES_DB=cpjudge

# 4. Proxy & Security Configuration
# Set to 'true' when deployed behind HTTPS / Reverse Proxy / Cloudflare
USE_PROXY_FIX=true
SESSION_COOKIE_SECURE=true
SESSION_COOKIE_SAMESITE=Lax
PREFERRED_URL_SCHEME=https

# 5. Distributed Rate Limiting (Redis)
RATELIMIT_STORAGE_URI=redis://redis:6379/0

# 6. Timezone Configuration (Pakistan Standard Time, UTC+5)
APP_TIMEZONE=Asia/Karachi
TZ=Asia/Karachi

# 7. Sandbox Settings
USE_BWRAP=true
SANDBOX_USER=judge_sandbox
